<!-- Table 2: Multi-SDG Format (SDG 9, 12, 16) in case the university evaluates multiple goals -->
<h3>Option B: Comprehensive Multi-SDG Mapping (SDG 9, SDG 12 &amp; SDG 16)</h3>
<table>
  <thead>
    <tr>
      <th style="width: 12%;">COs</th>
      <th style="width: 25%;">SDG MAPPED</th>
      <th style="width: 15%;">LEVEL OF MAPPING</th>
      <th style="width: 48%;">JUSTIFICATION</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="co-header">PCO1</td>
      <td>SDG 9: Industry, Innovation and Infrastructure</td>
      <td class="center">3</td>
      <td>Delivers an innovative digital desktop management interface that modernizes telecommunication service infrastructure.</td>
    </tr>
    <tr>
      <td class="co-header">PCO2</td>
      <td>SDG 16: Peace, Justice &amp; Strong Institutions</td>
      <td class="center">3</td>
      <td>Builds transparent, auditable, and secure database repositories that protect consumer data and financial transactions.</td>
    </tr>
    <tr>
      <td class="co-header">PCO3</td>
      <td>SDG 9: Industry, Innovation and Infrastructure</td>
      <td class="center">3</td>
      <td>Implements robust JDBC middleware enabling resilient, interconnected data infrastructure for ISP operations.</td>
    </tr>
    <tr>
      <td class="co-header">PCO4</td>
      <td>SDG 16: Peace, Justice &amp; Strong Institutions</td>
      <td class="center">3</td>
      <td>Enforces defensive cyber controls and parameterized validation to prevent cybercrime and maintain institutional data safety.</td>
    </tr>
    <tr>
      <td class="co-header">PCO5</td>
      <td>SDG 12: Responsible Consumption &amp; Production</td>
      <td class="center">3</td>
      <td>Replaces paper invoices with automated digital billing, substantially reducing paper consumption and administrative waste.</td>
    </tr>
    <tr>
      <td class="co-header">PCO6</td>
      <td>SDG 16: Peace, Justice &amp; Strong Institutions</td>
      <td class="center">3</td>
      <td>Validates billing calculations and system operations to ensure zero financial discrepancies and maintain consumer trust.</td>
    </tr>
  </tbody>
</table>

